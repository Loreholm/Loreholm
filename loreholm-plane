#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PORT=${LOREHOLM_WIZARD_PORT:-8765}
printf 'Loreholm Plane Foundry: http://127.0.0.1:%s\n' "$PORT"
if command -v xdg-open >/dev/null 2>&1; then
  (sleep 1; xdg-open "http://127.0.0.1:$PORT" >/dev/null 2>&1 || true) &
fi
exec python3 "$ROOT/plane-wizard/wizard.py"
